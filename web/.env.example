# Firebase — Proyecto inga-kamentsa
# Copia este archivo a .env.local y completa los valores desde Firebase Console > Project Settings > General
# No commitear .env.local (ya está ignorado en web/.gitignore)

# Modo de datos: firebase | mock | legacy
NEXT_PUBLIC_DATA_MODE=firebase

# Firebase Web SDK (NEXT_PUBLIC_ = expuesto al browser)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=inga-kamentsa.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=inga-kamentsa
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=inga-kamentsa.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# Opcional: Admin SDK (solo server-side, nunca NEXT_PUBLIC_)
# FIREBASE_ADMIN_PROJECT_ID=inga-kamentsa
# FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@inga-kamentsa.iam.gserviceaccount.com
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...your_key...\n-----END PRIVATE KEY-----\n"

# Backend MySQL (web/server) — Express + Prisma
# El frontend puede consumir la API MySQL vía fetch en lugar de Firestore cuando DATA_MODE lo requiera
NEXT_PUBLIC_API_URL=http://localhost:4000
